ENVIRONMENT=development
LOG_LEVEL=INFO
# Leave the key blank until configured locally. Never commit .env.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_TIMEOUT_SECONDS=45
NEBIUS_MAX_TOKENS=2048
# Phase 9: disabled | fixture | live. Fixture also requires n8n/infrastructure fixture modes.
# Live sends the question and restricted tool evidence to Nebius and can consume credits.
INVESTIGATION_MODE=disabled
# Phase 10: automatically open/reuse incidents for saved UNHEALTHY observations.
# Requires migrated application storage. Never resolves an incident or writes to providers.
INCIDENTS_ENABLED=false
# Registered public websites only; no arbitrary URLs in API requests.
# Example: [{"id":"homepage","url":"https://your-site.example/"}]
WEBSITE_TARGETS=[]
# Optional public DNS IPs; empty uses the OS resolver configuration.
WEBSITE_DNS_NAMESERVERS=[]
# Phase 5: disabled by default. fixture needs no credentials; live is opt-in.
N8N_MODE=disabled
# Public HTTPS API root, including /api/v1/. Never enter a key in this URL.
N8N_BASE_URL=
N8N_API_KEY=
N8N_TIMEOUT_SECONDS=10
N8N_DNS_NAMESERVERS=[]
# Phase 6: fixture uses local HTTP/driver mocks; live is explicitly enabled.
INFRASTRUCTURE_MODE=disabled
INFRASTRUCTURE_TIMEOUT_SECONDS=10
INFRASTRUCTURE_DNS_NAMESERVERS=[]
# A single configured deployment; this is not proof of production alias health.
VERCEL_TOKEN=
VERCEL_DEPLOYMENT_ID=
VERCEL_TEAM_ID=
# Management API access token, not a project anon/service-role key.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Public DNS hostname only; verified TLS, fixed read-only query, no arbitrary DSN/SQL.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DBNAME=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Phase 7 application history: independent of the monitored POSTGRES_* target.
# disabled | local (file on D:) | postgresql (dedicated application database).
STORAGE_MODE=disabled
STORAGE_SQLITE_FILE=work/data/reliability.sqlite3
# postgresql+psycopg://user:password@host:5432/database (no query options).
STORAGE_DATABASE_URL=
# Only isolated local PostgreSQL tests may opt into loopback/plaintext.
STORAGE_ALLOW_LOOPBACK=false

# Phase 11: operator-only approved retry; separate from monitoring and AI tools.
N8N_RETRY_MODE=disabled
N8N_RETRY_WORKFLOW_IDS=[]
