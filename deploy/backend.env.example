# Supply these in the hosting platform's secret/environment settings.
ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8000
API_ACCESS_TOKEN=
API_ALLOWED_HOSTS=["your-backend.example"]
STORAGE_MODE=postgresql
# Dedicated application database/user; not the monitored POSTGRES_* credentials.
# Percent-encode special characters in credentials. TLS verify-full is automatic.
STORAGE_DATABASE_URL=
# Absolute path to the project's downloaded CA certificate, if required.
STORAGE_SSL_CA_FILE=
STORAGE_ALLOW_LOOPBACK=false
INCIDENTS_ENABLED=false
INVESTIGATION_MODE=disabled
N8N_MODE=disabled
N8N_EVENTS_ENABLED=false
N8N_EVENTS_TOKEN=
N8N_EVENTS_WORKFLOW_IDS=[]
N8N_RETRY_MODE=disabled
N8N_RETRY_WORKFLOW_IDS=[]
N8N_RECOVERY_MODE=disabled
N8N_RECOVERY_FLOWS={}
INFRASTRUCTURE_MODE=disabled
WEBSITE_TARGETS=[]
WEBSITE_MONITORING_ENABLED=false
WEBSITE_MONITORING_INTERVAL_SECONDS=300
