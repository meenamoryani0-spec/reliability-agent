# These are SERVER secrets/settings, never NEXT_PUBLIC_* values.
RELIABILITY_DASHBOARD_MODE=production
# Required on other hosts/custom domains. May be omitted on Vercel production,
# using its trusted VERCEL_PROJECT_PRODUCTION_URL (system variables enabled).
RELIABILITY_PUBLIC_ORIGIN=https://your-dashboard.example
RELIABILITY_BACKEND_URL=https://your-backend.example
RELIABILITY_BACKEND_TOKEN=
RELIABILITY_SESSION_KEY=
RELIABILITY_OPERATOR_KEY_SHA256=
